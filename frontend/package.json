{
  "name": "@ci-coordinator/operator-ui",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "browser:prepare": "playwright install chromium",
    "browser:ui": "node dev/cli.mjs ui",
    "browser:debug": "node dev/cli.mjs debug",
    "browser:record": "node dev/cli.mjs record",
    "build": "pnpm run build:assets && python ../scripts/frontend_bundle.py --write-manifest",
    "build:assets": "tsc -b && vite build --configLoader native --config dev/production.vite.config.ts",
    "check": "pnpm run lint && tsc -b && pnpm run test:coverage",
    "lint": "biome check . && pnpm run lint:promises && pnpm run lint:promises:contract && pnpm run lint:transport:contract",
    "lint:promises": "eslint src tests dev --max-warnings=0",
    "lint:promises:contract": "node tools/promise-lint-contract.mjs",
    "lint:transport:contract": "node tools/transport-lint-contract.mjs",
    "contract:check": "openapi-typescript openapi/workbench.openapi.json --output src/api/generated.ts --immutable --alphabetize --check",
    "contract:generate": "openapi-typescript openapi/workbench.openapi.json --output src/api/generated.ts --immutable --alphabetize",
    "dev": "vite --configLoader native --host 0.0.0.0 --port 5173",
    "dev:demo": "node dev/cli.mjs demo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled=true",
    "test:browser": "pnpm build && playwright test"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.14",
    "@mermaid-lint/core": "0.53.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "jsdom": "30.1.0",
    "mermaid": "12.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
