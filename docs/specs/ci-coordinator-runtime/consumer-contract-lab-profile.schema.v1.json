{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/research-engineering/ci-coordinator/schemas/consumer-contract-lab-profile.schema.v1.json",
  "$comment": "Structural preflight only. The runtime codec owns canonical JSON, UTF-8 byte bounds, ordering, cross-record uniqueness, and exact admission.",
  "title": "CI Coordinator Consumer Contract Lab Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "expectedCoordinatorCommit",
    "repository",
    "workflowPath",
    "eventSurface",
    "targetArtifactsDirectory",
    "dynamicPolicy",
    "scenarioCorpus",
    "targetBindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ci-coordinator-consumer-lab-profile/v1"
    },
    "profileId": {
      "$ref": "#/$defs/identifier"
    },
    "expectedCoordinatorCommit": {
      "$ref": "#/$defs/gitCommit"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "workflowPath": {
      "$ref": "#/$defs/workflowPath"
    },
    "eventSurface": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["merge_group", "pull_request", "push"]
      }
    },
    "targetArtifactsDirectory": {
      "$ref": "#/$defs/path"
    },
    "dynamicPolicy": {
      "$ref": "#/$defs/fileBinding"
    },
    "scenarioCorpus": {
      "$ref": "#/$defs/fileBinding"
    },
    "targetBindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/fileBinding"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/|\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "workflowPath": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^\\.github/workflows/[^/\\\\]+\\.ya?ml$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installationId",
        "repositoryId",
        "owner",
        "name",
        "defaultBranch"
      ],
      "properties": {
        "installationId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "repositoryId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    }
  }
}
