{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/research-engineering/ci-coordinator/schemas/consumer-contract-lab-scenarios.schema.v1.json",
  "$comment": "Structural preflight only. The runtime codec owns canonical JSON, UTF-8 byte bounds, ordering, cross-record uniqueness, and exact admission.",
  "title": "CI Coordinator Consumer Contract Lab Scenarios V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "scenarios"],
  "properties": {
    "schemaVersion": {
      "const": "ci-coordinator-consumer-lab-scenarios/v1"
    },
    "profileId": {
      "$ref": "#/$defs/identifier"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/|\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "previousPath"],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "status": {
          "enum": ["added", "modified", "removed", "renamed", "copied", "changed"]
        },
        "previousPath": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/path"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "renamed"
              }
            }
          },
          "then": {
            "properties": {
              "previousPath": {
                "$ref": "#/$defs/path"
              }
            }
          },
          "else": {
            "properties": {
              "previousPath": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "expectedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "selectedJobs"],
      "properties": {
        "mode": {
          "enum": ["selected", "fallback"]
        },
        "selectedJobs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/jobId"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "selected"
              }
            }
          },
          "then": {
            "properties": {
              "selectedJobs": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "selectedJobs": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "eventName",
        "changes",
        "expectedOutcome"
      ],
      "properties": {
        "scenarioId": {
          "$ref": "#/$defs/identifier"
        },
        "eventName": {
          "enum": ["merge_group", "pull_request", "push"]
        },
        "changes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "expectedOutcome": {
          "$ref": "#/$defs/expectedOutcome"
        }
      }
    }
  }
}
