{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-engineering.github.io/ci-coordinator/schemas/buildkit-provenance-predicate/v1",
  "title": "CI Coordinator BuildKit SLSA v1 provenance admission profile",
  "type": "object",
  "required": [
    "buildDefinition",
    "runDetails"
  ],
  "properties": {
    "buildDefinition": {
      "type": "object",
      "required": [
        "buildType",
        "externalParameters",
        "internalParameters",
        "resolvedDependencies"
      ],
      "properties": {
        "buildType": {
          "const": "https://github.com/moby/buildkit/blob/master/docs/attestations/slsa-definitions.md"
        },
        "externalParameters": {
          "type": "object",
          "required": [
            "configSource",
            "request"
          ],
          "properties": {
            "configSource": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "const": "Dockerfile"
                }
              }
            },
            "request": {
              "type": "object",
              "required": [
                "args",
                "frontend",
                "locals"
              ],
              "properties": {
                "args": {
                  "type": "object",
                  "minProperties": 1
                },
                "frontend": {
                  "const": "dockerfile.v0"
                },
                "locals": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "allOf": [
                    {
                      "contains": {
                        "type": "object",
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "const": "context"
                          }
                        }
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "const": "dockerfile"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "internalParameters": {
          "type": "object",
          "required": [
            "buildConfig",
            "builderPlatform"
          ],
          "properties": {
            "buildConfig": {
              "type": "object",
              "required": [
                "llbDefinition"
              ],
              "properties": {
                "llbDefinition": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "builderPlatform": {
              "const": "linux/amd64"
            }
          }
        },
        "resolvedDependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "digest",
              "uri"
            ],
            "properties": {
              "digest": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^[a-z0-9][a-z0-9+._-]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32,}$"
                }
              },
              "uri": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "runDetails": {
      "type": "object",
      "required": [
        "builder",
        "metadata"
      ],
      "properties": {
        "builder": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          }
        },
        "metadata": {
          "type": "object",
          "required": [
            "buildkit_completeness",
            "buildkit_metadata",
            "finishedOn",
            "invocationId",
            "startedOn"
          ],
          "properties": {
            "buildkit_completeness": {
              "type": "object",
              "required": [
                "request",
                "resolvedDependencies"
              ],
              "properties": {
                "request": {
                  "type": "boolean"
                },
                "resolvedDependencies": {
                  "type": "boolean"
                }
              }
            },
            "buildkit_metadata": {
              "type": "object"
            },
            "finishedOn": {
              "type": "string",
              "format": "date-time"
            },
            "invocationId": {
              "type": "string",
              "minLength": 1
            },
            "startedOn": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
