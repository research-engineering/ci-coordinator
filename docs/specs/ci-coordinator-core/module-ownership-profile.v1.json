      "pathPatterns": ["backend/src/ci_coordinator/kernel/clock.py"]
    },
    {
      "responsibilityId": "workflow-source-authority",
      "description": "Pure exact Git-object workflow manifest and source-binding evidence",
      "pathPatterns": ["backend/src/ci_coordinator/workflow_authority/*.py"]
