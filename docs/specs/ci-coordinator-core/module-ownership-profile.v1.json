{
  "schemaVersion": 1,
  "profileId": "ci-coordinator.module-ownership.v1",
  "ownerId": "ci-coordinator.core",
  "reviewSignals": {
    "signalOnly": true,
    "metrics": [
      {
        "metricId": "physical-lines",
        "operator": "gt",
        "threshold": 400,
        "applicableSuffixes": ["*"],
        "applicableFileKinds": [
          "composition-root",
          "production-authority",
          "production-like-script",
          "test"
        ]
      },
      {
        "metricId": "recognized-public-declarations",
        "operator": "gt",
        "threshold": 12,
        "applicableSuffixes": [".cjs", ".cts", ".js", ".jsx", ".mjs", ".mts", ".py", ".ts", ".tsx"],
        "applicableFileKinds": [
          "composition-root",
          "production-authority",
          "production-like-script"
        ]
      },
      {
        "metricId": "first-party-import-contexts",
        "operator": "gte",
        "threshold": 3,
        "applicableSuffixes": [".cjs", ".cts", ".js", ".jsx", ".mjs", ".mts", ".py", ".ts", ".tsx"],
        "applicableFileKinds": [
          "composition-root",
          "production-authority",
          "production-like-script",
          "test"
        ]
      }
    ],
    "grammarId": "ci-coordinator.module-ownership-signals.v2",
    "runtimeIds": ["cpython-3.13.15"],
    "unknownDisposition": "review-required",
    "verdictCeiling": "review-required"
  },
  "candidateQueue": {
    "cappedDeferredVerdict": "abstain",
    "defaultMaximumCandidates": null,
    "requiresCompletenessAccounting": true,
    "separateTestCohort": true
  },
  "traversalLimits": {
    "maximumDepth": 16,
    "maximumEntries": 4096,
    "maximumOwnedFiles": 2048,
    "maximumCandidateFileBytes": 8388608,
    "gitPathDiscoveryTimeoutSeconds": 30,
    "maximumRelativePathBytes": 2048,
    "maximumTotalCandidateBytes": 268435456,
    "maximumTotalPathBytes": 4194304
  },
  "fileKinds": [
    "composition-root",
    "declarative",
    "documentation",
    "generated",
    "migration",
    "other",
    "production-authority",
    "production-like-script",
    "test",
    "vendor-build-cache"
  ],
  "fileKindClassification": {
    "resolution": "first-match",
    "defaultKind": "other",
    "rules": [
      {
        "kind": "test",
        "pathPatterns": [
          "backend/tests/**",
          "fixtures/**",
          "frontend/tests/**",
          "frontend/tools/*.test.ts",
          "frontend/tools/diagrams*-checks.mjs",
          "scripts/**/*_test.py",
          "scripts/tests/**",
          "test_*.py"
        ]
      },
      {
        "kind": "migration",
        "pathPatterns": ["backend/alembic/**"]
      },
      {
        "kind": "generated",
        "pathPatterns": ["frontend/src/api/generated.ts"]
      },
      {
        "kind": "composition-root",
        "pathPatterns": [
          "backend/src/ci_coordinator/api/http/app.py",
          "backend/src/ci_coordinator/runtime/composition.py",
          "backend/src/ci_coordinator/runtime/control_plane_composition.py"
        ]
      },
      {
        "kind": "documentation",
        "pathPatterns": ["*.md", "docs/**/*.md"]
      },
      {
        "kind": "vendor-build-cache",
        "pathPatterns": [
          "**/.mypy_cache/**",
          "**/.pytest_cache/**",
          "**/.ruff_cache/**",
          "**/.venv/**",
          "**/__pycache__/**",
          "**/coverage/**",
          "**/dist/**",
          "**/node_modules/**",
          "**/vendor/**"
        ]
      },
      {
        "kind": "production-like-script",
        "pathPatterns": [
          ".devcontainer/*.sh",
          ".githooks/*",
          ".github/actions/**/*.py",
          ".github/actions/**/*.sh",
          "docker/**/*.sh",
          "frontend/*.config.ts",
          "frontend/tools/*.mjs",
          "frontend/tools/*.ts",
          "scripts/**/*.py",
          "scripts/**/*.sql",
          "scripts/*.py"
        ]
      },
      {
        "kind": "declarative",
        "pathPatterns": [
          "**/*.Dockerfile",
          "**/*.ini",
          "**/*.json",
          "**/*.lock",
          "**/*.patch",
          "**/*.toml",
          "**/*.yaml",
          "**/*.yml",
          "**/.dockerignore",
          "**/.env.example",
          "**/.gitignore",
          "**/.npmrc",
          "**/Dockerfile",
          "**/Dockerfile.*",
          "*.Dockerfile",
          "*.ini",
          "*.json",
          "*.lock",
          "*.patch",
          "*.toml",
          "*.yaml",
          "*.yml",
          ".devcontainer/**",
          ".dockerignore",
          ".env.example",
          ".github/**",
          ".gitignore",
          ".npmrc",
          "Dockerfile",
          "Dockerfile.*"
        ]
      },
      {
        "kind": "production-authority",
        "pathPatterns": ["backend/src/**", "frontend/index.html", "frontend/src/**"]
      }
    ]
  },
  "exclusiveOwnershipRoots": [
    {
      "root": "frontend/src/api",
      "suffixes": [".cts", ".mts", ".ts", ".tsx"],
      "responsibilityIds": [
        "frontend-api.activity",
        "frontend-api.ci-economics",
        "frontend-api.config-activation",
        "frontend-api.config-lifecycle",
        "frontend-api.control-plane-identity",
        "frontend-api.development",
        "frontend-api.generated",
        "frontend-api.governance-baseline",
        "frontend-api.governance-comparison",
        "frontend-api.governance-observation",
        "frontend-api.provider-inventory",
        "frontend-api.repository-attestation",
        "frontend-api.shared-transport",
        "frontend-api.workbench",
        "frontend-api.workflow-discovery"
      ]
    }
  ],
  "responsibilities": [
    {
      "responsibilityId": "audit-checkpoint-admission",
      "description": "Pure authenticated audit-checkpoint and bounded successor-chain admission",
      "pathPatterns": ["backend/src/ci_coordinator/audit_replay/checkpoint*.py"]
    },
    {
      "responsibilityId": "capacity-qualification",
      "description": "Pure admission of externally signed capacity and audit-storage evidence",
      "pathPatterns": ["backend/src/ci_coordinator/capacity_qualification/*.py"]
    },
    {
      "responsibilityId": "ci-economics-evidence",
      "description": "Pure CI evidence identity, collection lifecycle, measurement, and query contracts",
      "pathPatterns": ["backend/src/ci_coordinator/ci_economics/*.py"]
    },
    {
      "responsibilityId": "domain-planning",
      "description": "Pure deterministic planning policy",
      "pathPatterns": ["backend/src/ci_coordinator/planning_core/*.py"]
    },
    {
      "responsibilityId": "frontend-api.activity",
      "description": "Authorized administrator activity query, reference admission and export transport",
      "pathPatterns": [
        "frontend/src/api/activity/*.ts"
      ]
    },
    {
      "responsibilityId": "frontend-api.ci-economics",
