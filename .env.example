CI_COORDINATOR_RUNTIME_MODE=disabled
CI_COORDINATOR_BIND_HOST=0.0.0.0
CI_COORDINATOR_BIND_PORT=3000
CI_COORDINATOR_SHUTDOWN_TIMEOUT_SECONDS=30

# Required when CI_COORDINATOR_RUNTIME_MODE is non_enforcing or enforcing.
# Uncomment this block together and select exactly one direct or file-backed form
# for each secret-bearing setting.
# CI_COORDINATOR_REQUEST_TIMEOUT_SECONDS=15
# CI_COORDINATOR_MAXIMUM_RETAINED_BODY_BYTES=33554432
# CI_COORDINATOR_DATABASE_POOL_SIZE=16
# CI_COORDINATOR_DATABASE_POOL_TIMEOUT_SECONDS=5
# CI_COORDINATOR_PLAN_TTL_SECONDS=120
# CI_COORDINATOR_RECONCILIATION_INTERVAL_SECONDS=30
# CI_COORDINATOR_RECONCILIATION_STARTUP_TIMEOUT_SECONDS=30
# CI_COORDINATOR_RECONCILIATION_SCAN_LIMIT=100
# CI_COORDINATOR_SHADOW_ROLLOUT_PROFILE_ID=replace-me-with-64-lowercase-hex-digest
# CI_COORDINATOR_DATABASE_DSN_FILE=/run/secrets/database-dsn
# Alternative: CI_COORDINATOR_DATABASE_DSN=postgresql+psycopg://replace-me
# CI_COORDINATOR_WEBHOOK_SECRET_FILE=/run/secrets/webhook-secret
# Alternative: CI_COORDINATOR_WEBHOOK_SECRET=replace-me
# CI_COORDINATOR_GITHUB_APP_ID=replace-me
# CI_COORDINATOR_GITHUB_PRIVATE_KEY_FILE=/run/secrets/github-private-key.pem
# Alternative: CI_COORDINATOR_GITHUB_PRIVATE_KEY=replace-me-with-pem
# CI_COORDINATOR_PLAN_SIGNING_KEY_ID=replace-me
# CI_COORDINATOR_PLAN_SIGNING_PRIVATE_KEY_FILE=/run/secrets/plan-signing-private-key.pem
# Alternative: CI_COORDINATOR_PLAN_SIGNING_PRIVATE_KEY=replace-me
# CI_COORDINATOR_OIDC_AUDIENCE=ci-coordinator
# CI_COORDINATOR_OIDC_ALLOWED_WORKFLOW_REFS=
# CI_COORDINATOR_OIDC_ALLOWED_JOB_WORKFLOW_REFS=
# CI_COORDINATOR_OIDC_ALLOWED_WORKFLOW_PATHS=owner/repository/.github/workflows/full-check.yml
# CI_COORDINATOR_OIDC_ALLOWED_JOB_WORKFLOW_PATHS=
# CI_COORDINATOR_BREAK_GLASS_ACTOR_ID=break-glass:v1:replace-me
# CI_COORDINATOR_BREAK_GLASS_BEARER_TOKEN_FILE=/run/secrets/break-glass-bearer-token
# Alternative: CI_COORDINATOR_BREAK_GLASS_BEARER_TOKEN=replace-me
# CI_COORDINATOR_METRICS_BEARER_TOKEN_FILE=/run/secrets/metrics-bearer-token
# Alternative: CI_COORDINATOR_METRICS_BEARER_TOKEN=replace-me-with-header-safe-random-token
# CI_COORDINATOR_CONTROL_PLANE_SCOPE_ALLOWLIST=1:2
# CI_COORDINATOR_CONTROL_PLANE_INVENTORY_INSTALLATION_ALLOWLIST=
# App mode discovers all installations; it does not grant repository commands.
# CI_COORDINATOR_CONTROL_PLANE_INVENTORY_MODE=restricted
# CI_COORDINATOR_CONTROL_PLANE_SCOPE_MODE=restricted

# Optional explicit proxy for provider API, OAuth, OIDC discovery, and JWKS requests.
# Ambient HTTP(S)_PROXY and NO_PROXY variables are intentionally ignored.
# CI_COORDINATOR_OUTBOUND_PROXY_URL=http://proxy.example.com:3128

# Optional organization control-plane identity. Omit the complete block to keep it disabled.
# Client and issuer values are exact deployment-profile identities, not free-form aliases.
# CI_COORDINATOR_CONTROL_PLANE_AUTH_MODE=keycloak
# CI_COORDINATOR_KEYCLOAK_ISSUER=https://auth.example.test/realms/coordinator
# CI_COORDINATOR_KEYCLOAK_BROWSER_CLIENT_ID=ci-coordinator-admin-ui
# CI_COORDINATOR_KEYCLOAK_BROWSER_CLIENT_SECRET_FILE=/run/secrets/keycloak-browser-client-secret
# Alternative: CI_COORDINATOR_KEYCLOAK_BROWSER_CLIENT_SECRET=replace-me
# CI_COORDINATOR_KEYCLOAK_API_CLIENT_ID=ci-coordinator-admin-api
# CI_COORDINATOR_PUBLIC_ORIGIN=https://ci-coordinator.example.com
# CI_COORDINATOR_CONTROL_PLANE_SESSION_KEY_FILE=/run/secrets/control-plane-session-key
# Alternative: CI_COORDINATOR_CONTROL_PLANE_SESSION_KEY=replace-me-with-canonical-32-byte-base64url
# CI_COORDINATOR_CONTROL_PLANE_SESSION_MAXIMUM_SECONDS=900
# CI_COORDINATOR_KEYCLOAK_WORKLOAD_CLIENT_ALLOWLIST=review-bot
# CI_COORDINATOR_GITHUB_APP_CLIENT_ID=Iv1SyntheticClient01
# CI_COORDINATOR_GITHUB_APP_CLIENT_SECRET_FILE=/run/secrets/github-app-client-secret
# Alternative: CI_COORDINATOR_GITHUB_APP_CLIENT_SECRET=replace-me

# Required only when CI_COORDINATOR_RUNTIME_MODE=enforcing.
# CI_COORDINATOR_PRODUCTION_ADMISSION_RECEIPT_PATH=/var/run/ci-coordinator/production-admission.json
# CI_COORDINATOR_PRODUCTION_ADMISSION_KEY_ID=replace-me
# CI_COORDINATOR_PRODUCTION_ADMISSION_PUBLIC_KEY_PEM_FILE=/run/secrets/production-admission-public-key.pem
# Alternative: CI_COORDINATOR_PRODUCTION_ADMISSION_PUBLIC_KEY_PEM=replace-me-with-ed25519-public-key-pem
# CI_COORDINATOR_DEPLOYED_ARTIFACT_DIGEST=sha256:replace-me-with-64-lowercase-hex-digest
# CI_COORDINATOR_ENVIRONMENT_ID=production
# CI_COORDINATOR_ENFORCEMENT_SCOPE_ALLOWLIST=1:2
