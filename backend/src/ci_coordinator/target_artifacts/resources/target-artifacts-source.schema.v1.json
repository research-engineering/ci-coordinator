{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ci-coordinator.example/ci-coordinator/target-artifacts-source.schema.v1.json",
  "title": "CI Coordinator target artifact source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generator",
    "adapterWorkflowFiles",
    "executionWorkflows",
    "executionProfiles",
    "tests",
    "dependencyGraph"
  ],
  "properties": {
    "schemaVersion": {"const": "dynamic-ci-target-artifacts-source/v1"},
    "generator": {"$ref": "#/$defs/generator"},
    "adapterWorkflowFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/adapterWorkflowFile"}
    },
    "executionWorkflows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/workflow"}
    },
    "executionProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/profile"}
    },
    "tests": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/test"}
    },
    "dependencyGraph": {"$ref": "#/$defs/dependencyGraph"}
  },
  "$defs": {
    "adapterWorkflowFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$",
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "workflowPath",
        "jobId",
        "executionKind",
        "runnerProfileId",
        "permissionProfileId",
        "credentialProfileId",
        "fixtureProfileId",
        "serviceProfileIds",
        "capacityClassId"
      ],
      "properties": {
        "profileId": {"$ref": "#/$defs/identifier"},
        "workflowPath": {
          "type": "string",
          "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$",
          "maxLength": 256
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
        },
        "executionKind": {"enum": ["witness-shards", "native-job-set"]},
        "runnerProfileId": {"$ref": "#/$defs/identifier"},
        "permissionProfileId": {"$ref": "#/$defs/identifier"},
        "credentialProfileId": {"$ref": "#/$defs/identifier"},
        "fixtureProfileId": {"$ref": "#/$defs/identifier"},
        "serviceProfileIds": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "capacityClassId": {"$ref": "#/$defs/identifier"}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowPath",
        "executionKind",
        "executionJobs",
        "planRequestJobId",
        "planRequestWorkflowRef",
        "planJobId",
        "fallbackJobId",
        "gateJobId",
        "gateSignalName",
        "requiredJobIds"
      ],
      "properties": {
        "workflowPath": {
          "type": "string",
          "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$",
          "maxLength": 256
        },
        "executionKind": {"enum": ["witness-shards", "native-job-set"]},
        "executionJobs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/executionJob"
          }
        },
        "planRequestJobId": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
        },
        "planRequestWorkflowRef": {
          "type": "string",
          "anyOf": [
            {"const": "$/.github/workflows/trusted-plan-request.yml"},
            {"pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9_.-]{1,100}/\\.github/workflows/[^/]+\\.ya?ml@[0-9a-f]{40}$"}
          ],
          "maxLength": 512
        },
        "planJobId": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
        },
        "fallbackJobId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
            },
            {"type": "null"}
          ]
        },
        "gateJobId": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
        },
        "gateSignalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "requiredJobIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"executionKind": {"const": "witness-shards"}},
            "required": ["executionKind"]
          },
          "then": {"properties": {"fallbackJobId": {"type": "string"}}}
        },
        {
          "if": {
            "properties": {"executionKind": {"const": "native-job-set"}},
            "required": ["executionKind"]
          },
          "then": {"properties": {"fallbackJobId": {"type": "null"}}}
        }
      ]
    },
    "executionJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "needs"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
        },
        "needs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,127}$"
          }
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testId", "witnessId", "expectedSeconds"],
      "properties": {
        "testId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[ -~]+$"
        },
        "witnessId": {"$ref": "#/$defs/identifier"},
        "expectedSeconds": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 604800
        }
      }
    },
    "pathPattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "dependencyGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "invalidatesWhenChanged", "globalRiskPaths", "nodes"],
      "properties": {
        "source": {"enum": ["configured", "generated"]},
        "invalidatesWhenChanged": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/pathPattern"}
        },
        "globalRiskPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/pathPattern"}
        },
        "nodes": {
          "type": "array",
          "maxItems": 100000,
          "items": {"$ref": "#/$defs/node"}
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "dependents", "riskClasses"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "dependents": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        },
        "riskClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
