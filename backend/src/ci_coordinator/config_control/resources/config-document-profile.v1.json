    "numberDomain": {
      "finite": true,
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "sourceProjection": "JSON and YAML numeric tokens denote their nearest IEEE-754 binary64 value; safe integer tokens preserve their exact value",
      "integerClassification": "the projected binary64 value has zero fractional part",
      "appliesTo": ["integer", "non-integer"],
