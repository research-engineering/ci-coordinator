    "versionDirectiveMismatchFailure": "parse.invalid_syntax",
    "emptyStreamProjection": "null",
    "allowMultipleDocuments": false,
    "allowDuplicateKeys": false,
    "allowAnchors": false,
    "allowAliases": false,
    "allowMergeKeys": false,
    "allowCustomTags": false,
    "allowNonStringKeys": false,
