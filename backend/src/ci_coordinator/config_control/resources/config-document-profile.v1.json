    "ruleIdProjection": {
      "fixedByCode": {
        "source.too_large": "source.max-utf8-bytes",
        "source.unsupported_format": "source.accepted-format",
        "decode.invalid_utf8": "decode.utf8",
        "decode.byte_order_mark_forbidden": "decode.byte-order-mark",
        "parse.invalid_syntax": "parse.syntax",
        "parse.multiple_documents_forbidden": "parse.single-document",
        "parse.duplicate_key": "parse.unique-key",
        "parse.graph_feature_forbidden": "parse.no-graph-features",
        "parse.custom_tag_forbidden": "parse.no-custom-tags",
        "parse.non_string_key": "parse.string-keys",
        "parse.non_finite_number": "parse.finite-number",
