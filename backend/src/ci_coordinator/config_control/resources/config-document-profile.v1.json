      "parseRule": "lowest source offset reported by the deterministic token or event preflight; ties use codes order",
      "structureRule": "first failure from structuralFailureAlgorithm",
      "semanticsRule": "minimum diagnosticOrdering tuple after evaluating every rule in semanticProfilePath",
      "feasibilityRule": "minimum diagnosticOrdering tuple after evaluating every feasibility rule",
      "compileRule": "minimum diagnosticOrdering tuple after compilation and output admission",
      "diagnosticOrdering": [
        "phaseOrder-index",
        "instancePointer",
        "codes-index",
        "ruleId",
        "kernel.canonical-json(parameters)"
      ]
    },
    "parsePointerProjection": {
      "parse.invalid_syntax": "root",
