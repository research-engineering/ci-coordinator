    "scopeProjection": "kernel.canonical_json({installationId,repositoryId})",
    "epochIdProjection": "sha256(utf8(ci-config-epoch/v1) + nul + scopeProjection + nul + asciiLowerHex(sourceHash) + nul + asciiLowerHex(documentHash) + nul + asciiLowerHex(epochHash))"
  },
  "resourceLimitRationale": {
    "maxUtf8Bytes": "Operational admission ceiling for repository policy source before decoding or parser allocation.",
    "maxDepth": "Finite recursion ceiling shared by every accepted source format.",
    "maxNodes": "The schema cardinality maximum is 26042 nodes under the kernel tree measure; 32768 admits that complete domain with explicit slack and rejects structurally larger documents."
