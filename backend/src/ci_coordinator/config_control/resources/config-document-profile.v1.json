      "instancePointerVocabulary": "schema-known property names plus array indices only",
      "messageProjection": "static template selected by code and ruleId; no source interpolation"
    },
    "shape": {
      "requiredFields": ["code", "phase", "ruleId", "instancePointer", "parameters"],
      "additionalProperties": false,
      "fieldTypes": {
        "code": { "enumRef": "diagnostics.codes" },
        "phase": { "enumRef": "diagnostics.phaseOrder" },
