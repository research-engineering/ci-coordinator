      "directFields": ["dependencyGraph.source", "fallbackTimeoutSeconds"],
      "sortedUniqueFields": [
        "riskClasses",
        "agentAdvice.modelIdAllowlist",
        "agentAdvice.promptHashAllowlist",
        "dependencyGraph.globalRiskPaths"
