    "parseLocationProjection": {
      "offsetUnit": "zero-based decoded Unicode scalar index",
      "lineColumnUnit": "one-based Unicode scalar positions",
      "lineTerminators": "LF, CR, and CRLF each terminate one line; CRLF is one terminator",
      "nonBmpWidth": "one column",
      "parse.invalid_syntax": "first unexpected or missing token position",
      "parse.multiple_documents_forbidden": "second document start",
      "parse.duplicate_key": "second key token start",
      "parse.graph_feature_forbidden": "forbidden event start",
      "parse.custom_tag_forbidden": "tagged event start",
      "parse.non_string_key": "key event start",
      "parse.non_finite_number": "scalar token or event start",
      "parse.unsafe_integer": "scalar token or event start",
      "parse.unpaired_surrogate": "string token or event start",
      "resource.max_depth_exceeded": "candidate value token or event start",
      "resource.max_nodes_exceeded": "candidate value token or event start",
      "sameOffsetSelection": "lowest diagnostics.codes index"
    },
    "structuralFailureAlgorithm": {
      "referenceResolution": "resolve only local refs before evaluation",
      "oneOfSelection": "select the unique branch whose resolved JSON type matches the instance before evaluating that branch",
      "allOfSelection": "evaluate subschemas in array order",
      "traversal": "pre-order",
      "objectChildOrder": "schema property names in Unicode scalar order",
      "arrayChildOrder": "ascending index",
      "keywordOrder": [
