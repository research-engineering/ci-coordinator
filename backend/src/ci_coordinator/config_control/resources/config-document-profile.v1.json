  "normalization": {
    "algorithm": "recursive-default-projection/v1",
    "propertyDefaultLookup": "use a direct default annotation on the property subschema, otherwise follow only terminal local $ref targets; oneOf and allOf do not synthesize an absent-property default",
    "allOfProjection": "for every present or inserted value, recurse through allOf subschemas in array order",
    "steps": [
      "validate parsed input against structuralSchemaPath without applying defaults",
      "resolve only local schema references",
      "for each absent optional property with a default annotation, deep-copy that exact JSON value",
      "recurse into every present or inserted object property and array item",
      "select the unique oneOf branch against the pre-default value before recursing",
      "validate the projected result against structuralSchemaPath",
      "require every pointer pattern in requiredNormalizedPointers to exist unless an ancestor is null"
    ],
    "requiredNormalizedPointers": [
      "/repository/dynamicCi",
      "/repository/rules/*/timing",
      "/repository/rules/*/timing/absencePollLookbackSeconds",
      "/repository/rules/*/omittedSignals",
      "/repository/dynamicCi/planningEnabled",
      "/repository/dynamicCi/riskClasses",
      "/repository/dynamicCi/agentAdvice",
      "/repository/dynamicCi/agentAdvice/enabled",
      "/repository/dynamicCi/agentAdvice/modelIdAllowlist",
