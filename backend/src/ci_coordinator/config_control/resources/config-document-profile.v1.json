        "dependencyGraph.globalRiskPaths": "globalRiskPaths"
      }
    },
    "setOrder": "ECMAScript-UTF16",
    "validateOutputAgainst": "compiledSchemaPath"
  },
  "outputs": {
    "maxNormalizedDocumentCanonicalBytes": 4194304,
    "maxCompiledPolicyCanonicalBytes": 4194304,
    "byteAdmission": {
      "measure": "canonical-json-utf-8-octets/v1",
      "candidateProjections": ["normalized-document", "compiled-policy"],
      "evaluation": "measure both projections and create one compile.output_too_large candidate for each overflow",
      "overflowObserved": "the applicable limit plus one",
      "encoderTermination": "stop a projection after proving its limit plus one overflow sentinel",
      "failureSelection": "minimum candidate under diagnostics.failureSelection.diagnosticOrdering",
