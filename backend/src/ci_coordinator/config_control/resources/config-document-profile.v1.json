    "nonJsonStandardTagFailure": "parse.custom_tag_forbidden",
    "unicodeEscapeProjection": "fold valid UTF-16 surrogate pairs to one Unicode scalar before duplicate-key comparison and construction; reject every unpaired surrogate"
