    "compiledStructuralFailureAlgorithm": {
      "baseAlgorithm": "diagnostics.structuralFailureAlgorithm",
      "schema": "compiledSchemaPath",
      "instance": "compiled policy before canonical serialization or hashing",
      "code": "compile.output_invalid",
      "ruleId": "schema:<failed-keyword>",
      "parameters": "schemaKeyword and resolved schemaPointer under compiledSchemaPath",
