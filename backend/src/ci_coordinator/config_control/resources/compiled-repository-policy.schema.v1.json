{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/research-engineering/ci-coordinator/schemas/compiled-repository-policy.schema.v1.json",
  "title": "CI Coordinator Compiled Repository Policy V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "owner", "name", "defaultBranch", "rules", "dynamicCi"],
  "properties": {
    "schemaVersion": { "const": "ci-compiled-repository-policy/v1" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installationId", "repositoryId"],
      "properties": {
        "installationId": { "$ref": "#/$defs/positiveSafeInteger" },
        "repositoryId": { "$ref": "#/$defs/positiveSafeInteger" }
      }
    },
    "owner": { "$ref": "#/$defs/nonEmptyString" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "defaultBranch": { "$ref": "#/$defs/nonEmptyString" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/compiledRule" }
    },
    "dynamicCi": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/compiledDynamicCi" }]
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nominalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "validationDepth": {
      "enum": ["smoke", "targeted", "standard", "full", "exhaustive"]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedSignalTimeoutSeconds",
        "absenceVerificationWindowSeconds",
        "absencePollLookbackSeconds",
        "lateFindingWindowSeconds",
        "mutableDecisionWindowSeconds"
      ],
      "properties": {
        "expectedSignalTimeoutSeconds": { "$ref": "#/$defs/positiveSafeInteger" },
        "absenceVerificationWindowSeconds": { "$ref": "#/$defs/positiveSafeInteger" },
        "absencePollLookbackSeconds": { "$ref": "#/$defs/positiveSafeInteger" },
        "lateFindingWindowSeconds": { "$ref": "#/$defs/positiveSafeInteger" },
        "mutableDecisionWindowSeconds": { "$ref": "#/$defs/positiveSafeInteger" }
      }
    },
    "expectedSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "workflowFile", "source", "requiredConclusion", "required"],
      "properties": {
        "kind": { "const": "workflow" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "workflowFile": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "enum": ["native", "dispatch"] },
        "requiredConclusion": { "const": "success" },
        "required": { "const": true }
      }
    },
    "omittedSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "workflowFile", "verifyAbsence", "reason"],
      "properties": {
        "kind": { "const": "workflow" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "workflowFile": { "$ref": "#/$defs/nonEmptyString" },
        "verifyAbsence": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "compiledRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "event",
        "branches",
        "mode",
        "timing",
        "expectedSignals",
        "omittedSignals"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "event": { "enum": ["merge_group", "pull_request", "push"] },
        "branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "mode": { "enum": ["observe", "hybrid"] },
        "timing": { "$ref": "#/$defs/timing" },
        "expectedSignals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/expectedSignal" }
        },
        "omittedSignals": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/omittedSignal" }
        }
      }
    },
    "compiledDynamicCi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyHash",
        "configuredValidationCatalogHash",
        "riskClasses",
        "agentAdvice",
        "dependencyGraphSource",
        "globalRiskPaths",
        "fallbackTimeoutSeconds",
        "obligations",
        "witnesses",
        "executionProfiles"
      ],
      "properties": {
        "policyHash": { "$ref": "#/$defs/sha256" },
        "configuredValidationCatalogHash": { "$ref": "#/$defs/sha256" },
        "riskClasses": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "agentAdvice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "modelIdAllowlist",
            "promptHashAllowlist",
            "minConfidence",
            "promptInjectionEvalRequired"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "modelIdAllowlist": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 }
            },
            "promptHashAllowlist": {
              "type": "array",
              "maxItems": 64,
              "items": { "$ref": "#/$defs/sha256" }
            },
            "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "promptInjectionEvalRequired": { "type": "boolean" }
          }
        },
        "dependencyGraphSource": { "enum": ["configured", "generated"] },
        "globalRiskPaths": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "fallbackTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/compiledValidationObligation" }
        },
        "witnesses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/compiledExecutableWitness" }
        },
        "executionProfiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/compiledExecutionProfile" }
        }
      }
    },
    "compiledValidationObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligationId",
        "responsibility",
        "requiredWitnessIds",
        "defaultDepth",
        "fullDepth",
        "omitAllowed"
      ],
      "properties": {
        "obligationId": { "$ref": "#/$defs/nominalId" },
        "responsibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "riskClasses"],
          "properties": {
            "paths": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "riskClasses": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "requiredWitnessIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/nominalId" }
        },
        "defaultDepth": { "$ref": "#/$defs/validationDepth" },
        "fullDepth": { "$ref": "#/$defs/validationDepth" },
        "omitAllowed": { "type": "boolean" }
      }
    },
    "compiledExecutableWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["witnessId", "executionProfileId", "supportedDepths"],
      "properties": {
        "witnessId": { "$ref": "#/$defs/nominalId" },
        "executionProfileId": { "$ref": "#/$defs/nominalId" },
        "supportedDepths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/validationDepth" }
        }
      }
    },
    "compiledExecutionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "runnerProfileId",
        "permissionProfileId",
        "credentialProfileId",
        "fixtureProfileId",
        "serviceProfileIds",
        "capacityClassId",
        "shardingPolicy"
      ],
      "properties": {
        "profileId": { "$ref": "#/$defs/nominalId" },
        "runnerProfileId": { "$ref": "#/$defs/nominalId" },
        "permissionProfileId": { "$ref": "#/$defs/nominalId" },
        "credentialProfileId": { "$ref": "#/$defs/nominalId" },
        "fixtureProfileId": { "$ref": "#/$defs/nominalId" },
        "serviceProfileIds": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/nominalId" }
        },
        "capacityClassId": { "$ref": "#/$defs/nominalId" },
        "shardingPolicy": { "$ref": "#/$defs/compiledShardingPolicy" }
      }
    },
    "compiledShardingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxShards",
        "maxParallel",
        "maxItemsPerShard",
        "setupSecondsPerShard",
        "cpuWeight",
        "wallWeight",
        "operatorWeight"
      ],
      "properties": {
        "maxShards": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxParallel": { "type": "integer", "minimum": 1, "maximum": 256 },
        "maxItemsPerShard": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "setupSecondsPerShard": { "type": "number", "minimum": 0, "maximum": 3600 },
        "cpuWeight": { "type": "number", "minimum": 0, "maximum": 1000 },
        "wallWeight": { "type": "number", "minimum": 0, "maximum": 1000 },
        "operatorWeight": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    }
  }
}
